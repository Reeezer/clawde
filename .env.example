# clawde secrets — copy to .env (never commit .env). Settings prefix: CLAWDE_
# Bring your own model: provide a key for whichever provider(s) you use. You need
# at least one to run the agent. Nested keys use `__` (pydantic-settings).

# --- Providers (BYOM) ---------------------------------------------------------
# Anthropic (Claude)
CLAWDE_PROVIDERS__ANTHROPIC__API_KEY=
# OpenAI
CLAWDE_PROVIDERS__OPENAI__API_KEY=
# Google Gemini
CLAWDE_PROVIDERS__GEMINI__API_KEY=
# Ollama (local) — no key; override the host if not the default:
#CLAWDE_PROVIDERS__OLLAMA__HOST=http://localhost:11434
# Any OpenAI-compatible endpoint — base URL + key:
#CLAWDE_PROVIDERS__OPENAI_COMPAT__BASE_URL=https://example.com/v1
#CLAWDE_PROVIDERS__OPENAI_COMPAT__API_KEY=

# --- Defaults -----------------------------------------------------------------
# Which provider/model the agent uses when not overridden on the CLI.
#CLAWDE_DEFAULT_PROVIDER=anthropic
#CLAWDE_DEFAULT_MODEL=claude-opus-4-8
