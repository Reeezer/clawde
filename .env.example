# clawde secrets — copy to .env (never commit .env). Settings prefix: CLAWDE_
# Bring your own model: provide a key for whichever provider(s) you use. You need
# at least one to run the agent. Nested keys use `__` (pydantic-settings).

# --- Providers (BYOM) ---------------------------------------------------------
# Anthropic (Claude)
CLAWDE_PROVIDERS__ANTHROPIC__API_KEY=
# Google Gemini
CLAWDE_PROVIDERS__GEMINI__API_KEY=
# OpenAI — the same provider also serves any OpenAI-compatible endpoint
# (Ollama, LM Studio, vLLM, …): set BASE_URL to point at it (any non-empty key
# works for a local endpoint). Leave BASE_URL unset to use api.openai.com.
CLAWDE_PROVIDERS__OPENAI__API_KEY=
#CLAWDE_PROVIDERS__OPENAI__BASE_URL=http://localhost:11434/v1

# --- Defaults -----------------------------------------------------------------
# Which provider/model the agent uses when not overridden on the CLI.
#CLAWDE_DEFAULT_PROVIDER=anthropic
#CLAWDE_DEFAULT_MODEL=claude-opus-4-8
# Tool-calling mode: 'native' (default) or 'json' — the JSON-in-text fallback for
# models without native function calling (e.g. many local models).
#CLAWDE_TOOL_CALLING=native
